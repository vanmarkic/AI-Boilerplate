r(--spacing-lg);\n    background: var(--color-card);\n    border: 1px solid var(--color-border);\n    border-left: 3px solid var(--color-muted);\n    border-radius: 0;\n    text-decoration: none;\n    color: inherit;\n    transition:\n      border-color var(--duration-fast),\n      background var(--duration-fast),\n      box-shadow var(--duration-fast),\n      transform var(--duration-fast);\n    cursor: pointer;\n  }\n\n  .tac-panel:hover {\n    background: color-mix(\n      in oklch,\n      var(--color-card) 90%,\n      var(--color-primary) 10%\n    );\n    border-left-color: var(--color-primary);\n    transform: translateX(4px);\n    box-shadow: -4px 0 12px oklch(70% 0.15 195 / 20%);\n  }\n\n  .tac-panel[data-primary] {\n    border-left-color: var(--color-primary);\n  }\n\n  .tac-panel__indicator {\n    width: 2rem;\n    height: 2rem;\n    flex-shrink: 0;","numLines":40,"startLine":94,"totalLines":231}},"sourceToolAssistantUUID":"caa0bed6-9494-4b15-bab2-a936a9e011c0","userType":"external","entrypoint":"claude-vscode","cwd":"/Users/dragan/Documents/AI-Boilerplate","sessionId":"b9adbe46-ab57-4ceb-9993-27a5ea193c44","version":"2.1.81","gitBranch":"master","slug":"parsed-doodling-swing"}

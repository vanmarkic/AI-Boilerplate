{"parentUuid":"2e68bfbe-8f73-49c4-8be9-0d909c574bb4","isSidechain":false,"promptId":"1bf922e4-091b-4694-b97e-b4d5aa0acbec","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NfXfUgM8LQcUBZMmBTTQri","type":"tool_result","content":"The file /Users/dragan/Documents/AI-Boilerplate/apps/tfc/frontend/src/app/shared/components-home.css has been updated successfully."}]},"uuid":"3f9d8dc7-c16e-4893-93d8-944cbdf1a87e","timestamp":"2026-03-23T07:37:59.856Z","toolUseResult":{"filePath":"/Users/dragan/Documents/AI-Boilerplate/apps/tfc/frontend/src/app/shared/components-home.css","oldString":"  .tac-panel:hover {\n    background: color-mix(\n      in oklch,\n      var(--color-card) 90%,\n      var(--color-primary) 10%\n    );\n    border-left-color: var(--color-primary);\n    transform: translateX(4px);\n    box-shadow: -4px 0 12px oklch(70% 0.15 195 / 20%);\n  }","newString":"  .tac-panel:hover {\n    background: oklch(20% 0.02 195 / 65%);\n    border-left-color: var(--color-primary);\n    transform: translateX(4px);\n    box-shadow: -4px 0 12px oklch(70% 0.15 195 / 20%);\n  }","originalFile":"/* ── TFC Home Screen — Command Center ────────────────────\n *  Tactical operations aesthetic for the main menu,\n *  scenario picker flow, and mode selector.\n * ──────────────────────────────────────────────────────── */\n\n@layer components {\n  /* ── Host ─────────────────────────────────────────────── */\n\n  .home-host {\n    display: block;\n    position: relative;\n    min-height: 100dvh;\n    isolation: isolate;\n  }\n\n  /* ── Layout ───────────────────────────────────────────── */\n\n  .home-layout {\n    position: relative;\n    z-index: 1;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    min-height: 100dvh;\n    padding: var(--spacing-xl);\n    gap: var(--spacing-xl);\n  }\n\n  /* ── Hero / System Title ──────────────────────────────── */\n\n  .home-hero {\n    text-align: center;\n    position: relative;\n    padding: var(--spacing-lg) var(--spacing-xl);\n  }\n\n  .home-hero::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: repeating-linear-gradient(\n      0deg,\n      transparent,\n      transparent 2px,\n      var(--overlay-scanline) 2px,\n      var(--overlay-scanline) 4px\n    );\n    pointer-events: none;\n    border-radius: var(--radius-sm);\n  }\n\n  .home-hero__title {\n    font-family: var(--font-mono);\n    font-size: var(--font-size-4xl);\n    font-weight: 700;\n    color: var(--color-primary);\n    text-transform: uppercase;\n    letter-spacing: 0.08em;\n    margin: 0 0 var(--spacing-xs);\n  }\n\n  .home-hero__title::before {\n    content: \"[ \";\n    color: var(--color-muted-foreground);\n    font-weight: 400;\n  }\n\n  .home-hero__title::after {\n    content: \" ]\";\n    color: var(--color-muted-foreground);\n    font-weight: 400;\n  }\n\n  .home-hero__subtitle {\n    font-family: var(--font-mono);\n    font-size: var(--font-size-xs);\n    text-transform: uppercase;\n    letter-spacing: 0.06em;\n    color: var(--color-muted-foreground);\n    margin: 0;\n  }\n\n  /* ── Navigation Menu ──────────────────────────────────── */\n\n  .home-menu {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: var(--spacing-md);\n    width: 100%;\n    max-width: 720px;\n  }\n\n  /* ── Tactical Panel Cards ─────────────────────────────── */\n\n  .tac-panel {\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    gap: var(--spacing-sm);\n    padding: var(--spacing-lg);\n    background: oklch(18% 0.008 250 / 60%);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n    border: 1px solid oklch(100% 0 0 / 6%);\n    border-left: 3px solid var(--color-muted);\n    border-radius: 0;\n    text-decoration: none;\n    color: inherit;\n    overflow: hidden;\n    transition:\n      border-color var(--duration-fast),\n      background var(--duration-fast),\n      box-shadow var(--duration-fast),\n      transform var(--duration-fast);\n    cursor: pointer;\n  }\n\n  .tac-panel::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(\n      90deg,\n      transparent 0%,\n      oklch(70% 0.15 195 / 8%) 45%,\n      oklch(70% 0.15 195 / 12%) 50%,\n      oklch(70% 0.15 195 / 8%) 55%,\n      transparent 100%\n    );\n    translate: -100% 0;\n    pointer-events: none;\n  }\n\n  .tac-panel:hover::after {\n    translate: 100% 0;\n    transition: translate 0.6s var(--ease-default);\n  }\n\n  .tac-panel:hover {\n    background: color-mix(\n      in oklch,\n      var(--color-card) 90%,\n      var(--color-primary) 10%\n    );\n    border-left-color: var(--color-primary);\n    transform: translateX(4px);\n    box-shadow: -4px 0 12px oklch(70% 0.15 195 / 20%);\n  }\n\n  .tac-panel[data-primary] {\n    grid-column: 1 / -1;\n    border-left-color: var(--color-primary);\n    border-color: oklch(70% 0.15 195 / 30%);\n    background: oklch(18% 0.02 195 / 55%);\n    box-shadow: 0 0 20px oklch(70% 0.15 195 / 12%);\n  }\n\n  .tac-panel[data-primary] .tac-panel__label {\n    font-size: var(--font-size-md);\n  }\n\n  .tac-panel__indicator {\n    width: 2rem;\n    height: 2rem;\n    flex-shrink: 0;\n    border-radius: var(--radius-sm);\n    background: var(--color-primary);\n    color: var(--color-primary-foreground);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-family: var(--font-mono);\n    font-size: var(--font-size-xs);\n    font-weight: 700;\n    text-transform: uppercase;\n  }\n\n  .tac-panel__label {\n    font-family: var(--font-mono);\n    font-size: var(--font-size-sm);\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 0.04em;\n  }\n\n  .tac-panel__desc {\n    font-size: var(--font-size-xs);\n    color: var(--color-muted-foreground);\n    line-height: 1.4;\n  }\n\n  /* ── Mode Selector ────────────────────────────────────── */\n\n  .mode-heading {\n    font-family: var(--font-mono);\n    font-size: var(--font-size-sm);\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 0.06em;\n    color: var(--color-primary);\n    margin: 0;\n  }\n\n  .mode-options {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: var(--spacing-md);\n  }\n\n  /* ── Picker Grid (shared layout) ──────────────────────── */\n\n  .picker-grid {\n    display: flex;\n    flex-direction: column;\n    gap: var(--spacing-md);\n    max-width: 560px;\n    width: 100%;\n  }\n\n  /* ── Back Link ────────────────────────────────────────── */\n\n  /* ── Join Exercise Live Badge ─────────────────────────── */\n\n  .lobby-live-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: var(--spacing-xs);\n    font-family: var(--font-mono);\n    font-size: var(--font-size-xs);\n    text-transform: uppercase;\n    letter-spacing: 0.04em;\n    color: var(--color-success);\n  }\n\n  .lobby-live-badge__light {\n    width: 6px;\n    height: 6px;\n    border-radius: var(--radius-full);\n    background: var(--color-success);\n    box-shadow: 0 0 6px var(--color-success);\n  }\n\n  /* ── Back Link ────────────────────────────────────────── */\n\n  .back-link {\n    font-family: var(--font-mono);\n    font-size: var(--font-size-xs);\n    text-transform: uppercase;\n    letter-spacing: 0.04em;\n    color: var(--color-muted-foreground);\n    cursor: pointer;\n    text-decoration: none;\n  }\n\n  .back-link::before {\n    content: \"< \";\n  }\n\n  .back-link:hover {\n    color: var(--color-primary);\n  }\n}\n","structuredPatch":[{"oldStart":138,"oldLines":11,"newStart":138,"newLines":7,"lines":["   }"," ","   .tac-panel:hover {","-    background: color-mix(","-      in oklch,","-      var(--color-card) 90%,","-      var(--color-primary) 10%","-    );","+    background: oklch(20% 0.02 195 / 65%);","     border-left-color: var(--color-primary);","     transform: translateX(4px);","     box-shadow
# Docker Compose environment — copy to .env and customise.
# .env is gitignored; .env.example is committed as a reference.

# ── Tier (feature set) ──────────────────────────────────────
TIER=3

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=boilerplate
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev

# ── Keycloak ────────────────────────────────────────────────
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=boilerplate
KEYCLOAK_AUDIENCE=backend-api

# ── Backend ─────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Frontend (runtime injection in prod builds) ─────────────
API_BASE_URL=http://localhost:8000
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_CLIENT_ID=frontend-app
PRODUCTION=false

{
  "name": "tfc-frontend",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4201",
    "build": "ng build",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "lint:tsc:app": "tsc --noEmit -p tsconfig.app.json",
    "lint:tsc:spec": "tsc --noEmit -p tsconfig.spec.json",
    "lint:tsc:all": "npm run lint:tsc:app && npm run lint:tsc:spec",
    "lint": "eslint 'src/**/*.ts'",
    "e2e": "playwright test",
    "e2e:changed": "bash ../../../shared/scripts/e2e-changed.sh origin/master tfc && npx playwright test --grep \"$(bash ../../../shared/scripts/e2e-changed.sh origin/master tfc)\" || npx playwright test",
    "e2e:tag": "playwright test --grep",
    "e2e:shard": "playwright test --shard",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:visual": "playwright test --grep @visual",
    "e2e:visual:update": "playwright test --grep @visual --update-snapshots",
    "generate:types": "python3 ../codegen/generate-types.py"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.2",
    "@angular/common": "^21.2.3",
    "@angular/compiler": "^21.2.3",
    "@angular/core": "^21.2.3",
    "@angular/forms": "^21.2.3",
    "@angular/platform-browser": "^21.2.3",
    "@angular/router": "^21.2.3",
    "@aspect/design-system": "*",
    "@aspect/ui": "*",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@ngrx/signals": "^21.0.1",
    "gsap": "^3.14.2",
    "pmtiles": "^4.4.0",
    "rxjs": "~7.8.0",
    "three": "^0.184.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.2",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.58.2",
    "@types/three": "^0.184.1",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.0.3",
    "fast-check": "^4.6.0",
    "typescript": "~5.9.2"
  }
}

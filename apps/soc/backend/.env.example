# --- service ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5434/soc
ENVIRONMENT=development
APP_NAME="SOC Platform API"

# --- auth (Keycloak) -------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=boilerplate
KEYCLOAK_AUDIENCE=soc-api

# --- port -> adapter selection ---------------------------------------------
# Every port defaults to `memory`: the service runs its full pipeline with no
# third party deployed. Point at a real system by changing one value here.
SEARCH_PROVIDER=memory              # memory | opensearch
THREAT_INTEL_PROVIDER=memory        # memory | misp
CASE_PROVIDER=memory                # memory | iris
ORCHESTRATION_PROVIDER=memory       # memory | shuffle
REPOSITORY_PROVIDER=memory          # memory (postgres not yet implemented)

# --- OpenSearch ------------------------------------------------------------
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_TLS=true
OPENSEARCH_EVENT_INDEX=soc-events
OPENSEARCH_INDICATOR_INDEX=soc-indicators

# --- MISP ------------------------------------------------------------------
# The key is sent bare, with no Bearer prefix. MISP rejects a Bearer scheme.
MISP_URL=https://misp.local
MISP_API_KEY=
MISP_VERIFY_TLS=true

# --- DFIR-IRIS -------------------------------------------------------------
IRIS_URL=https://iris.local
IRIS_API_KEY=
IRIS_VERIFY_TLS=true
IRIS_CUSTOMER_ID=1

# --- Shuffle ---------------------------------------------------------------
SHUFFLE_URL=https://shuffle.local
SHUFFLE_API_KEY=
SHUFFLE_VERIFY_TLS=true

# --- outbound HTTP behaviour ----------------------------------------------
HTTP_TIMEOUT_SECONDS=10.0
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=0.2
